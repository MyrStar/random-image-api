# 服务端口
PORT=3100

# 管理员账号
ADMIN_USER=admin
# ⚠️ 生产环境务必修改密码！（保持默认值时，生产环境将拒绝启动，见下方 ALLOW_INSECURE_DEFAULTS）
ADMIN_PASS=your_secure_password_here

# JWT密钥
# ⚠️ 生产环境务必修改！生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# 存储密钥加密密钥（随机字符串即可，建议 ≥32 位；生成方式: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"）
# ⚠️ 生产环境务必修改！保持下方默认值时，生产环境将拒绝启动
# ⚠️ 修改此值会导致已有存储源密钥无法解密！更换前请先删除所有存储源
ENCRYPT_KEY=0123456789abcdef0123456789abcdef

# 数据库文件路径
DB_PATH=./data/images.db

# 公开访问地址（用于生成API地址和管理后台显示）
PUBLIC_URL=http://localhost:3100

# CORS允许的来源（逗号分隔，* 表示全部允许，生产环境建议限制）
CORS_ORIGINS=*

# 反向代理信任配置（决定限流/日志取到的客户端IP是否信任 X-Forwarded-For）
# loopback=仅信任本机代理（默认，适合同机 Nginx）；数字=信任的代理跳数；CIDR=信任的网段（逗号分隔）
# TRUST_PROXY=loopback

# 逃生开关：设为 1 时生产环境允许使用默认弱密钥启动（仅明确知晓风险时使用）
# ALLOW_INSECURE_DEFAULTS=0
